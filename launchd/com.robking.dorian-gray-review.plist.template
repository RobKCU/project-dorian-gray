<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.robking.dorian-gray-review</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__DEST__/scripts/daily_run.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__DEST__</string>

  <!-- 08:30 each morning, plus an hourly check so a sleeping Mac catches up on waking. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>8</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>
  <key>StartInterval</key>
  <integer>3600</integer>

  <key>StandardOutPath</key>
  <string>__DEST__/data/logs/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>__DEST__/data/logs/launchd.err.log</string>

  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
